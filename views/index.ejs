<h1>Latest Posts</h1>

<% if (posts.length === 0) { %>
  <p class="empty">No posts yet. Check back soon.</p>
<% } else { %>
  <div class="post-grid">
    <% posts.forEach(post => { %>
      <article class="post-card">
        <% if (post.coverImage) { %>
          <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="post-card-image" />
        <% } %>
        <h2><a href="/posts/<%= post.slug %>"><%= post.title %></a></h2>
        <p class="post-meta">
          <%= post.createdAt.toDateString() %>
          <% if (post.author && post.author.username) { %> · by <%= post.author.username %><% } %>
        </p>
        <% if (post.excerpt) { %><p><%= post.excerpt %></p><% } %>
        <% if (post.tags && post.tags.length) { %>
          <div class="tags">
            <% post.tags.forEach(tag => { %><span class="tag"><%= tag %></span><% }) %>
          </div>
        <% } %>
        <a class="read-more" href="/posts/<%= post.slug %>">Read more &rarr;</a>
      </article>
    <% }) %>
  </div>
<% } %>
