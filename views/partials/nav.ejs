<header class="site-header">
  <nav class="container nav">
    <a class="brand" href="/">Personal Blog</a>
    <div class="nav-links">
      <a href="/">Home</a>
      <% if (currentUser) { %>
        <a href="/admin">Dashboard</a>
        <form action="/logout" method="POST" class="inline-form">
          <button type="submit" class="link-button">Logout (<%= currentUser %>)</button>
        </form>
      <% } else { %>
        <a href="/login">Login</a>
      <% } %>
    </div>
  </nav>
</header>
