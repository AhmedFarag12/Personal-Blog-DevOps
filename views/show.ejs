<article class="post-full">
  <% if (post.coverImage) { %>
    <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="post-full-image" />
  <% } %>
  <h1><%= post.title %></h1>
  <p class="post-meta">
    <%= post.createdAt.toDateString() %>
    <% if (post.author && post.author.username) { %> · by <%= post.author.username %><% } %>
  </p>
  <% if (post.tags && post.tags.length) { %>
    <div class="tags">
      <% post.tags.forEach(tag => { %><span class="tag"><%= tag %></span><% }) %>
    </div>
  <% } %>
  <div class="post-content"><%- post.content %></div>
</article>

<p><a href="/">&larr; Back to all posts</a></p>
